# Frontend Environment Variables (Vercel / Vite)
# Set this in your Vercel Project Settings -> Environment Variables to your deployed backend URL
# Example: https://calorie-calculator-api.onrender.com
VITE_API_BASE_URL=
# Optional Google OAuth Client ID (from Google Cloud Console Credentials)
VITE_GOOGLE_CLIENT_ID=

# Backend Environment Variables (Server)
PORT=3001
JWT_SECRET=your-secret-key-keep-it-safe
OPENAI_API_KEY=

# Supabase Database Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_publishable_vhAArM8tcsmlOKszifTZDg_mbqFDt2f

