# Frontend Environment Variables (Vercel / Vite)
# Set this in your Vercel Project Settings -> Environment Variables to your deployed backend URL
# Example: https://calorie-calculator-api.onrender.com
VITE_API_BASE_URL=

# Backend Environment Variables (Server)
PORT=3001
JWT_SECRET=your-secret-key-keep-it-safe
OPENAI_API_KEY=
